    "./diff": "./src/DiffViewer.tsx",
    "./review": "./src/ReviewPanel.tsx",
    "./ci": "./src/CIPanel.tsx",
    "./terminal": "./src/TerminalPanel.tsx",
    "./collab": "./src/collab.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.52.0",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1",
    "y-monaco": ">=0.1.6",
    "y-protocols": ">=1.0.6",
    "yjs": ">=13.6.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.6",
    "yjs": "13.6.20"
  }
