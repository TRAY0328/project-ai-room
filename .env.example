# PROJECT AI ROOM — environment template.
# Copy to .env (git-ignored) and fill only for local development.
# Never put production secrets in a PR, in CI logs, or in a client bundle.

# Cloudflare account (free plan)
CLOUDFLARE_ACCOUNT_ID=
# Workers AI / D1 / DO / R2 scoped token. Not the global API key.
CLOUDFLARE_API_TOKEN=
# D1 database id, filled after `wrangler d1 create`
D1_DATABASE_ID=
D1_DATABASE_NAME=ai_room_dev

# GitHub App (never a personal access token in production paths)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=

# Owner bootstrap: one-time, rotated, never logged
OWNER_BOOTSTRAP_SECRET=
AGENT_INVITE_SECRET=
AGENT_INVITE_SECRET_ROTATION_AT=

# Session / ticket signing
SESSION_SIGNING_KEY=
WS_TICKET_SIGNING_KEY=

# Provider adapters. Leave empty when the provider has no verified free
# unattended API — an empty value must surface as BLOCKED_EXTERNAL_DEPENDENCY,
# never as a mock success.
PROVIDER_GEMINI_API_KEY=
PROVIDER_OPENAI_API_KEY=
PROVIDER_ANTHROPIC_API_KEY=

# Environment: dev | test | staging | production
APP_ENV=dev
